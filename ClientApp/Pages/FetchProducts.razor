@page "/fetchproducts"
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http

<h3>Product List</h3>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<ul>
   @if (products != null)
    {
        foreach (var product in products)
        {
            <li>@product.Name - $@product.Price (Stock: @product.Stock) [Category: @product.Category?.Name]</li>
        }
    }
    else if (errorMessage == null)
    {
        <li>Loading...</li>
    }
</ul>

@code {
    private Product[]? products;
    private string? errorMessage;
    private static bool _isFetching = false; // Performance optimization: prevent redundant calls

    protected override async Task OnInitializedAsync()
    {
        if (_isFetching) return;
        _isFetching = true;

        try
        {
            // Activity 1 & 2: Integration code refined with Copilot for seamless communication
            // Activity 4: Reducing redundant calls by tracking fetch state
            var response = await Http.GetAsync("api/productlist");
            response.EnsureSuccessStatusCode();
            
            var json = await response.Content.ReadAsStringAsync();
            
            // Activity 3: Correctly consuming nested JSON structure
            products = JsonSerializer.Deserialize<Product[]>(json, new JsonSerializerOptions 
            { 
                PropertyNameCaseInsensitive = true 
            });
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            // Copilot suggested logging errors to the console for easier debugging
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            _isFetching = false;
        }
    }

    public class Product
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public double Price { get; set; }
        public int Stock { get; set; }
        // Activity 3: Nested Category object
        public Category? Category { get; set; }
    }

    public class Category
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}
